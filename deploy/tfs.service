# Servicio systemd. setup.sh reemplaza __DIR__ y __USER__ automaticamente.
[Unit]
Description=Tibia Mega Server (TFS)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__/compiler
ExecStart=__DIR__/compiler/build/tfs
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
